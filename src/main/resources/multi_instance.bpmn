<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1r7c2if" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="multi_instance_execute" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1gls8cm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1gls8cm" sourceRef="StartEvent_1" targetRef="Activity_0c635b4" />
    <bpmn:serviceTask id="Activity_0c635b4" name="Initialize Subject List" camunda:delegateExpression="${subjectsInitialize}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="errors">
            <camunda:script scriptFormat="JavaScript">var errors = [];
errors;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="JavaScript">print('Initialized Subject List: '+subjectList);</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1gls8cm</bpmn:incoming>
      <bpmn:outgoing>Flow_0x2ps17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0x2ps17" sourceRef="Activity_0c635b4" targetRef="Activity_1df7g2t" />
    <bpmn:scriptTask id="Activity_1df7g2t" name="Assign Subject Name" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0x2ps17</bpmn:incoming>
      <bpmn:outgoing>Flow_0t8ekf1</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${subjectList}" camunda:elementVariable="subjectObj">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">${subjectList.size()}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:script>print('subjectObj id: '+subjectObj.get('id'));

var id = subjectObj.get('id');

if (id == 1) {
        subjectObj.put('name', 'English');
} else if (id == 2) {
        subjectObj.put('name', 'Mathematics');
} else if (id == 3) {
        subjectObj.put('name', 'Science');
} else {
        subjectObj.put('name', 'Social Studies');
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0t8ekf1" sourceRef="Activity_1df7g2t" targetRef="Activity_1nq10wy" />
    <bpmn:scriptTask id="Activity_1nq10wy" name="Print Subject List" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0t8ekf1</bpmn:incoming>
      <bpmn:outgoing>Flow_082naua</bpmn:outgoing>
      <bpmn:script>print('SubjectList: '+subjectList);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_082naua" sourceRef="Activity_1nq10wy" targetRef="Activity_186r9ll" />
    <bpmn:serviceTask id="Activity_186r9ll" name="Assign Display Name" camunda:delegateExpression="${subjectDisplayName}">
      <bpmn:incoming>Flow_082naua</bpmn:incoming>
      <bpmn:outgoing>Flow_1yyu4sq</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${subjectList}" camunda:elementVariable="subjectObj">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">${subjectList.size()}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1yyu4sq" sourceRef="Activity_186r9ll" targetRef="Activity_0yy4gws" />
    <bpmn:scriptTask id="Activity_0yy4gws" name="Print Display Name" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_1yyu4sq</bpmn:incoming>
      <bpmn:outgoing>Flow_0conhw8</bpmn:outgoing>
      <bpmn:script>print('subject List: '+subjectList);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0conhw8" sourceRef="Activity_0yy4gws" targetRef="Activity_11ux1hc" />
    <bpmn:scriptTask id="Activity_11ux1hc" name="Convert Java List into JSON" scriptFormat="JavaScript" camunda:resultVariable="subjectArray">
      <bpmn:incoming>Flow_0conhw8</bpmn:incoming>
      <bpmn:outgoing>Flow_1mjogfj</bpmn:outgoing>
      <bpmn:script>var subjectArray = [];

for (var i=0;i&lt;subjectList.size();i++) {
        var subjectObj = {};

        var subjectMap = subjectList.get(i);

        subjectObj.id = subjectMap.get('id');
        subjectObj.name = subjectMap.get('name');
        subjectObj.displayName = subjectMap.get('displayName');

        subjectArray.push(subjectObj);
}

print('Subject Array JSON: '+JSON.stringify(subjectArray));

subjectArray;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1mjogfj" sourceRef="Activity_11ux1hc" targetRef="Activity_0miq055" />
    <bpmn:scriptTask id="Activity_0miq055" name="Convert JSON into JSON Node" scriptFormat="JavaScript" camunda:resultVariable="subjectListJSONNode">
      <bpmn:incoming>Flow_1mjogfj</bpmn:incoming>
      <bpmn:outgoing>Flow_04wycg6</bpmn:outgoing>
      <bpmn:script>S(JSON.stringify(subjectArray));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_04wycg6" sourceRef="Activity_0miq055" targetRef="Activity_08lab49" />
    <bpmn:subProcess id="Activity_08lab49">
      <bpmn:incoming>Flow_04wycg6</bpmn:incoming>
      <bpmn:outgoing>Flow_1wdu0q3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${subjectListJSONNode.elements()}" camunda:elementVariable="subjectObj">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">${subjectListJSONNode.elements().size()}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Event_1w342p2">
        <bpmn:outgoing>Flow_1u00mbj</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1u00mbj" sourceRef="Event_1w342p2" targetRef="Activity_1pa33w6" />
      <bpmn:sequenceFlow id="Flow_1ajauhe" sourceRef="Activity_1pa33w6" targetRef="Activity_1vlyndf" />
      <bpmn:endEvent id="Event_1hjdqot">
        <bpmn:incoming>Flow_1t5rys6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1t5rys6" sourceRef="Activity_1vlyndf" targetRef="Event_1hjdqot" />
      <bpmn:scriptTask id="Activity_1pa33w6" name="Assign Subject Code" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_1u00mbj</bpmn:incoming>
        <bpmn:outgoing>Flow_1ajauhe</bpmn:outgoing>
        <bpmn:script>var subjectName = subjectObj.prop('name').value();

var subjectCode = '';

if (subjectName == 'English') {
        subjectCode = 'Eng01';
} else if (subjectName == 'Mathematics') {
        subjectCode = 'Maths01';
} else if (subjectName == 'Science') {
        subjectCode = 'Sci01';
} else if (subjectName == 'Social Studies') {
        subjectCode = 'Soc01';
}

subjectObj.prop('code', subjectCode);</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_1vlyndf" name="Assign Teacher Info" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_1ajauhe</bpmn:incoming>
        <bpmn:outgoing>Flow_1t5rys6</bpmn:outgoing>
        <bpmn:script>var subjectName = subjectObj.prop('name').value();

var subjectTeacherId = '';
var subjectTeacherName = '';

switch(subjectName) {
        case 'English':
                subjectTeacherId = 101;
                subjectTeacherName = 'EnglishTeacher';
                break;
        case 'Mathematics':
                subjectTeacherId = 102;
                subjectTeacherName = 'MathsTeacher';
                break;
        case 'Science':
                subjectTeacherId = 103;
                subjectTeacherName = 'ScienceTeacher';
                break;
        case 'Social Studies':
                subjectTeacherId = 104;
                subjectTeacherName = 'SocialStudiesTeacher';
                break;
        default:
                subjectTeacherId = '';
                subjectTeacherName = '';
}

subjectObj.prop('subjectTeacherId',subjectTeacherId);
subjectObj.prop('subjectTeacherName',subjectTeacherName);</bpmn:script>
      </bpmn:scriptTask>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1wdu0q3" sourceRef="Activity_08lab49" targetRef="Activity_0j990tu" />
    <bpmn:scriptTask id="Activity_0j990tu" name="Print Subject Object" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_1wdu0q3</bpmn:incoming>
      <bpmn:outgoing>Flow_004wwtw</bpmn:outgoing>
