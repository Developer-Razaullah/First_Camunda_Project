<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0xw51g1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="dmns_execute" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1xfva3n</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1xfva3n" sourceRef="StartEvent_1" targetRef="Activity_1xc1frc" />
    <bpmn:scriptTask id="Activity_1xc1frc" name="user Object" scriptFormat="JavaScript" camunda:resultVariable="userObj">
      <bpmn:incoming>Flow_1xfva3n</bpmn:incoming>
      <bpmn:outgoing>Flow_1yv2smb</bpmn:outgoing>
      <bpmn:script>var user = {
    id: 1,
    name: 'A',
    age: 22,
    creditScore: 700
}

user;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1yv2smb" sourceRef="Activity_1xc1frc" targetRef="Activity_0k6lqlp" />
    <bpmn:businessRuleTask id="Activity_0k6lqlp" name="Loan Eligibity" camunda:resultVariable="isEligibilityForLoan" camunda:decisionRef="eligibility_for_loan_dmn" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1yv2smb</bpmn:incoming>
      <bpmn:outgoing>Flow_0qwpoww</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0qwpoww" sourceRef="Activity_0k6lqlp" targetRef="Activity_0w88lrj" />
    <bpmn:scriptTask id="Activity_0w88lrj" name="print Eligibility value" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0qwpoww</bpmn:incoming>
      <bpmn:outgoing>Flow_0d8qc5r</bpmn:outgoing>
      <bpmn:script>print('This user:'+JSON.stringify(userObj)+' Eligible for loan:'+isEligibilityForLoan);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0d8qc5r" sourceRef="Activity_0w88lrj" targetRef="Activity_0d1dljb" />
    <bpmn:businessRuleTask id="Activity_0d1dljb" name="Loan Eligibility With Discount" camunda:resultVariable="loadEligibilityWithDiscount" camunda:decisionRef="eligibility_for_loan_with_discount_dmn" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_0d8qc5r</bpmn:incoming>
      <bpmn:outgoing>Flow_04mnh3c</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_04mnh3c" sourceRef="Activity_0d1dljb" targetRef="Activity_12ownzo" />
    <bpmn:scriptTask id="Activity_12ownzo" name="print Eligibility value with Discount" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_04mnh3c</bpmn:incoming>
      <bpmn:outgoing>Flow_05ha3li</bpmn:outgoing>
      <bpmn:script>print('This user:'+JSON.stringify(userObj)+' Eligible for loan:'+loadEligibilityWithDiscount);

print("Discount:"+loadEligibilityWithDiscount.get("discount"));

print("Is Eligible for a loan:"+loadEligibilityWithDiscount.get("isEligibleForLoan"));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_05ha3li" sourceRef="Activity_12ownzo" targetRef="Activity_0u7zvb0" />
    <bpmn:scriptTask id="Activity_0u7zvb0" name="Initialize Subjects" scriptFormat="JavaScript" camunda:resultVariable="subjectObj">
      <bpmn:incoming>Flow_05ha3li</bpmn:incoming>
      <bpmn:outgoing>Flow_1519gyt</bpmn:outgoing>
      <bpmn:script>var obj = {
    id : 2,
    name: null,
    displayName: null,
    code: null,
    subjectTeacherId: null,
    subjectTeacherName: null
}

obj;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1519gyt" sourceRef="Activity_0u7zvb0" targetRef="Activity_1y4q76m" />
    <bpmn:businessRuleTask id="Activity_1y4q76m" name="Get Subject Name" camunda:resultVariable="subjectName" camunda:decisionRef="Subject_Id_By_Name" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="JavaScript">subjectObj.name = subjectName;

print("Subject Object After assigning name:"+JSON.stringify(subjectObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1519gyt</bpmn:incoming>
      <bpmn:outgoing>Flow_1p5dkh9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_1p5dkh9" sourceRef="Activity_1y4q76m" targetRef="Activity_0q7m7c9" />
    <bpmn:businessRuleTask id="Activity_0q7m7c9" name="Check Name And Code Null" camunda:resultVariable="subject" camunda:decisionRef="check_name_and_code_dmn_execute" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="JavaScript">print('errorMessage: ' + subject);</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1p5dkh9</bpmn:incoming>
      <bpmn:outgoing>Flow_0u7hjbp</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0u7hjbp" sourceRef="Activity_0q7m7c9" targetRef="Activity_0blwgq9" />
    <bpmn:businessRuleTask id="Activity_0blwgq9" name="Get Subject Attributes" camunda:resultVariable="subjectObjAttributes" camunda:decisionRef="subject_attributes_dmn" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="JavaScript">if (subjectObjAttributes) {
        subjectObj.displayName = subjectObjAttributes.get('subjectDisplayName');
        subjectObj.code = subjectObjAttributes.get('subjectCode');
        subjectObj.subjectTeacherId = subjectObjAttributes.get('subjectTeacherId');
        subjectObj.subjectTeacherName = subjectObjAttributes.get('subjectTeacherName');
}

print('Student Detail: '+JSON.stringify(subjectObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0u7hjbp</bpmn:incoming>
      <bpmn:outgoing>Flow_1nfkmc2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_1nfkmc2" sourceRef="Activity_0blwgq9" targetRef="Activity_0p2slk7" />
    <bpmn:businessRuleTask id="Activity_0p2slk7" name="Subject Validation" camunda:resultVariable="errorList" camunda:decisionRef="subject_validation_dmn">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="JavaScript">print('Error List: '+errorList);</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1nfkmc2</bpmn:incoming>
      <bpmn:outgoing>Flow_1pfpx59</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_1pfpx59" sourceRef="Activity_0p2slk7" targetRef="Activity_14vf8ed" />
    <bpmn:businessRuleTask id="Activity_14vf8ed" name="Subject Validation Collect" camunda:resultVariable="errorListCollect" camunda:decisionRef="subject_validation_collect_dmn">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="JavaScript">print('Error List: '+errorListCollect);</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1pfpx59</bpmn:incoming>
      <bpmn:outgoing>Flow_0u3wo2r</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="Event_1ykwmev">
      <bpmn:incoming>Flow_0u3wo2r</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0u3wo2r" sourceRef="Activity_14vf8ed" targetRef="Event_1ykwmev" />
  </bpmn:process>
