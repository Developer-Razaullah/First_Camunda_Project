        </outputEntry>
        <outputEntry id="LiteralExpression_07763bp">
          <text>"teacher01"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0qrq0ik">
        <inputEntry id="UnaryTests_1k55n1c">
          <text>"Mathematics"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1o4alg2">
          <text>"Maths"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_07pmkzq">
          <text>"M01"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0u4l6l1">
          <text>2</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0ln9jdq">
          <text>"teacher02"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1o78rc0">
        <inputEntry id="UnaryTests_0sw6g0h">
          <text>"Science"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0va9ddh">
          <text>"Sci"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_05u7kq5">
          <text>"S01"</text>
